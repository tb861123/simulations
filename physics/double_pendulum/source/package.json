{
  "name": "double-pendulum-chaos-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "single-file": "npm run build && node scripts/single-file.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/physics.test.ts tests/optimised.test.ts tests/workspace.test.ts",
    "test:engine": "node --experimental-strip-types --test tests/worker.test.mjs tests/pool.test.ts tests/enhancements.test.ts tests/accuracy.test.mjs tests/colours.test.ts tests/flip-spectrum.test.ts",
    "benchmark": "node --experimental-strip-types scripts/benchmark.ts"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  }
}
