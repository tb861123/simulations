{
  "name": "three-body-chaos-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/inline-build.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "serve": "node scripts/serve.mjs",
    "browser-check": "node tests/browser-check.mjs",
    "benchmark": "node --experimental-strip-types scripts/benchmark.ts",
    "package": "python3 scripts/package.py",
    "example": "node --experimental-strip-types scripts/make-example.ts"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  }
}
